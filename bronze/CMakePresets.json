{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "description": "Native build with Clang (Debug, sanitizers enabled by default)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++-20",
                "ENABLE_CLANG_TIDY": "ON",
                "ENABLE_SANITIZERS": "ON",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "description": "Native build with Clang (Release, optimized, no sanitizers)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++-20",
                "ENABLE_CLANG_TIDY": "ON",
                "ENABLE_SANITIZERS": "OFF",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "description": "Native build with GCC 14 (Debug, sanitizers enabled by default)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "g++-14",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENABLE_SANITIZERS": "ON",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "description": "Native build with GCC 14 (Release, optimized, no sanitizers)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/gcc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "g++-14",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENABLE_SANITIZERS": "OFF",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "stm32f429-debug",
            "displayName": "STM32F429 Debug",
            "description": "Cross-compilation for STM32F429 Discovery board (Debug build)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/stm32f429-debug",
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SYSTEM_NAME": "Generic",
                "CMAKE_SYSTEM_PROCESSOR": "ARM",
                "STM32_DEVICE": "STM32F429xx",
                "CMSIS_DEVICE_HEADER": "stm32f429xx.h",
                "LINKER_SCRIPT": "${sourceDir}/cmake/linker-scripts/STM32F429ZITx_FLASH.ld",
                "CMSIS_PATH": "${sourceDir}/vendor/CMSIS",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENABLE_SANITIZERS": "OFF",
                "BUILD_TESTS": "OFF"
            },
            "environment": {
                "CFLAGS": "-mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16",
                "CXXFLAGS": "-mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16"
            }
        },
        {
            "name": "stm32f429-release",
