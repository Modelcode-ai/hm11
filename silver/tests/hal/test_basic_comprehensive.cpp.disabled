// Comprehensive Basic Tests for HM11 Driver
// Tests existing implemented functionality thoroughly without referencing unimplemented features
// Validates core GATT, iBeacon, sensor operations that are actually available

#include <gtest/gtest.h>

#include <vector>
#include <string>

#include "hm11/hal/mock_uart.hpp"
#include "hm11/hm11_driver.hpp"
#include "hm11/types.hpp"

using namespace hm11;
using namespace hm11::hal;

class BasicComprehensiveTest : public ::testing::Test {
protected:
    void SetUp() override {
        // Each test creates its own driver with specific mock setup
    }

    void TearDown() override {
        // Clean up any resources
    }

    // Helper to create response data from string
    std::vector<uint8_t> create_response(const std::string& response) {
        return std::vector<uint8_t>(response.begin(), response.end());
    }

    // Verify transmitted command matches expected
    template <typename DriverType>
    void verify_command(const DriverType& driver, const std::string& expected) {
        const auto& transmitted = driver.GetUart().GetTransmitted8b();
        EXPECT_EQ(transmitted.size(), expected.size());
        if (transmitted.size() == expected.size()) {
            std::string actual(transmitted.begin(), transmitted.end());
            EXPECT_EQ(actual, expected);
        }
    }
};

// ============================================================================
// Basic Driver Operations Tests
// ============================================================================

TEST_F(BasicComprehensiveTest, DriverBasicOperations) {
    // Test core driver functionality that is definitely implemented
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    uart.SetReceiveData(create_response("OK"));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    // Test basic connectivity
    UARTStatus status = UARTStatus::ErrError;
    driver.Test(status);
    EXPECT_EQ(status, UARTStatus::Ok);
    verify_command(driver, "AT");
}

TEST_F(BasicComprehensiveTest, RoleOperations) {
    // Test role setting operations
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    uart.SetReceiveData(create_response("OK+Set:1"));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    UARTStatus status = UARTStatus::ErrError;
    driver.SetRole(Role::Central, status);
    EXPECT_EQ(status, UARTStatus::Ok);
    verify_command(driver, "AT+ROLE1");
}

TEST_F(BasicComprehensiveTest, NameOperations) {
    // Test device name operations
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    uart.SetReceiveData(create_response("OK+Set:TestDevice"));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    UARTStatus status = UARTStatus::ErrError;
    driver.SetName("TestDevice", status);
    EXPECT_EQ(status, UARTStatus::Ok);
    verify_command(driver, "AT+NAMETestDevice");
}

// ============================================================================
// GATT Basic Operations Tests
// ============================================================================

TEST_F(BasicComprehensiveTest, BasicGattDiscovery) {
    // Test basic GATT service discovery
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    
    const std::string response = 
        std::string(56, '*') + "\r\n" +
        "0001:0010:180D\r\n" +
        std::string(56, '*');
    
    uart.SetReceiveData(create_response(response));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    std::vector<std::string> discovered_services;
    auto callback = [](std::string_view service, void* user_data) {
        auto* services = static_cast<std::vector<std::string>*>(user_data);
        services->emplace_back(service);
    };
    
    UARTStatus status = UARTStatus::ErrError;
    driver.find_all_services_uuid(callback, &discovered_services, 3000, status);
    
    EXPECT_EQ(status, UARTStatus::Ok);
    EXPECT_GE(discovered_services.size(), 1);
    verify_command(driver, "AT+FINDALLPRIMARY?");
}

// ============================================================================
// iBeacon Basic Operations Tests  
// ============================================================================

TEST_F(BasicComprehensiveTest, BasicIBeaconConfiguration) {
    // Test basic iBeacon configuration
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    uart.SetReceiveData(create_response("OK+Set:1"));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    UARTStatus status = UARTStatus::ErrError;
    driver.set_ibeacon_switch(true, status);
    EXPECT_EQ(status, UARTStatus::Ok);
    verify_command(driver, "AT+IBEA1");
}

TEST_F(BasicComprehensiveTest, IBeaconVersionConfiguration) {
    // Test iBeacon version configuration
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    uart.SetReceiveData(create_response("OK+Set:0xFFE0"));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    const VersionType major("FFE0");
    UARTStatus status = UARTStatus::ErrError;
    driver.set_ibeacon_major_version(major, status);
    
    EXPECT_EQ(status, UARTStatus::Ok);
    verify_command(driver, "AT+MARJ0xFFE0");
