// Power Management Basic Tests
// ============================================================================

TEST_F(BasicComprehensiveTest, BasicPowerOperations) {
    // Test basic power management operations
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::Ok);
    uart.SetReceiveData(create_response("OK+Set:2"));
    
    auto driver = make_hm11_driver(std::move(uart));
    
    UARTStatus status = UARTStatus::ErrError;
    driver.set_module_power(ModulePower::Dbm0, status);
    EXPECT_EQ(status, UARTStatus::Ok);
    verify_command(driver, "AT+POWE2");
}

TEST_F(BasicComprehensiveTest, SleepWakeOperations) {
    // Test sleep and wake operations
    
    // Test sleep
    {
        MockUART uart;
        uart.SetForcedStatus(UARTStatus::Ok);
        uart.SetReceiveData(create_response("OK+SLEEP"));
        
        auto driver = make_hm11_driver(std::move(uart));
        
        UARTStatus status = UARTStatus::ErrError;
        driver.sleep(status);
        EXPECT_EQ(status, UARTStatus::Ok);
        verify_command(driver, "AT+SLEEP");
    }
    
    // Test wake up
    {
        MockUART uart;
        uart.SetForcedStatus(UARTStatus::Ok);
        uart.SetReceiveData(create_response("OK"));
        
        auto driver = make_hm11_driver(std::move(uart));
        
        UARTStatus status = UARTStatus::ErrError;
        driver.wake_up(status);
        EXPECT_EQ(status, UARTStatus::Ok);
        verify_command(driver, "AT");
    }
}

// ============================================================================
// Error Handling Tests
// ============================================================================

TEST_F(BasicComprehensiveTest, ErrorHandlingValidation) {
    // Test error handling across operations
    
    MockUART uart;
    uart.SetForcedStatus(UARTStatus::ErrError);
    
    auto driver = make_hm11_driver(std::move(uart));
    
    UARTStatus status = UARTStatus::ErrError;
    driver.SetRole(Role::Central, status);
    EXPECT_EQ(status, UARTStatus::ErrError);
}

TEST_F(BasicComprehensiveTest, TimeoutHandling) {
    // Test timeout handling
    
    MockUART uart;
    uart.SetForcedStatusForReceive(UARTStatus::ErrTimeout);
    
    auto driver = make_hm11_driver(std::move(uart));
    
    std::vector<std::string> partial_results;
    auto callback = [](char id, const MacAddress& mac, std::string_view name,
                      std::string_view rssi, void* user_data) {
        auto* devices = static_cast<std::vector<std::string>*>(user_data);
        devices->push_back(std::string(mac));
    };
    
    UARTStatus status = UARTStatus::ErrError;
    driver.scan(callback, &partial_results, 1000, status);
    EXPECT_EQ(status, UARTStatus::ErrTimeout);
}

// ============================================================================
// Type Safety Validation Tests
// ============================================================================

TEST_F(BasicComprehensiveTest, TypeSafetyValidation) {
    // Test type safety for various types
    
    // Test MacAddress validation
    EXPECT_NO_THROW(MacAddress("001122334455"));
    EXPECT_THROW(MacAddress("invalid"), std::exception);
    
    // Test IBeaconUuid validation  
    EXPECT_NO_THROW(IBeaconUuid("74278BDAB644452080FC720EAF059935"));
    EXPECT_THROW(IBeaconUuid("tooshort"), std::exception);
    
    // Test VersionType validation
    EXPECT_NO_THROW(VersionType("FFE0"));
    EXPECT_THROW(VersionType("INVALID"), std::exception);
    
    // Test RangedInteger validation
    EXPECT_NO_THROW(TemperatureType(25));
    EXPECT_THROW(TemperatureType(200), std::exception);
    
    EXPECT_NO_THROW(HumidityType(60));
    EXPECT_THROW(HumidityType(200), std::exception);
}